import os
import psycopg2
from psycopg2.extras import RealDictCursor
from pgvector.psycopg2 import register_vector
from openai import OpenAI
from dotenv import load_dotenv
import re

# ✅ Load environment variables
load_dotenv()

# ✅ Validate environment variables
required_env_vars = {
    'DB_HOST': os.environ.get('DB_HOST'),
    'DB_NAME': os.environ.get('DB_NAME'),
    'DB_USER': os.environ.get('DB_USER'),
    'DB_PASSWORD': os.environ.get('DB_PASSWORD'),
    'OPENAI_API_KEY': os.environ.get('OPENAI_API_KEY')
}
missing_vars = [var for var, value in required_env_vars.items() if not value]
if missing_vars:
    raise EnvironmentError(f"Missing env vars: {', '.join(missing_vars)}")

# ✅ DB and OpenAI setup
conn = psycopg2.connect(
    host=required_env_vars['DB_HOST'],
    database=required_env_vars['DB_NAME'],
    user=required_env_vars['DB_USER'],
    password=required_env_vars['DB_PASSWORD'],
    port=5432
)
register_vector(conn)
cursor = conn.cursor(cursor_factory=RealDictCursor)
client = OpenAI(api_key=required_env_vars['OPENAI_API_KEY'])

# ✅ Create updated maududi_documents table with chunk-level structure
cursor.execute("""
CREATE TABLE IF NOT EXISTS maududi_documents (
    id SERIAL PRIMARY KEY,
    heading_id INTEGER REFERENCES headings(id),
    chapter_id INTEGER REFERENCES chapters(id),
    book_id INTEGER REFERENCES books(id),
    book_title TEXT,
    chapter_title TEXT,
    chunk_index INTEGER,
    content TEXT,
    embedding VECTOR(3072),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
""")
conn.commit()

# ✅ Embedding helper
def create_embedding(text, model="text-embedding-3-large"):
    try:
        response = client.embeddings.create(input=text, model=model)
        return response.data[0].embedding
    except Exception as e:
        print(f"❌ Embedding error: {e}")
        return None

# ✅ Word-based chunking (800–1000 words)
def split_into_chunks(text, min_words=800, max_words=1000):
    words = re.findall(r'\S+', text)
    chunks = []
    i = 0
    while i < len(words):
        chunk_words = words[i:i+max_words]
        if len(chunk_words) < min_words and chunks:
            chunks[-1] += ' ' + ' '.join(chunk_words)
        else:
            chunks.append(' '.join(chunk_words))
        i += max_words
    return chunks

# ✅ Book selection
book_id = 2
cursor.execute("""
SELECT 
    b.id AS book_id, b.title AS book_title,
    ch.id AS chapter_id, ch.title AS chapter_title,
    h.id AS heading_id, h.content
FROM headings h
JOIN chapters ch ON h.chapter_id = ch.id
JOIN books b ON h.book_id = b.id
WHERE h.book_id = %s
ORDER BY ch.id, h.id;
""", (book_id,))
results = cursor.fetchall()

# ✅ Main embedding loop
for i, row in enumerate(results, start=1):
    book_id = row["book_id"]
    chapter_id = row["chapter_id"]
    heading_id = row["heading_id"]
    book_title = row["book_title"]
    chapter_title = row["chapter_title"]
    content = row["content"]

    if isinstance(content, list):
        content = " ".join(content)
    if not content.strip():
        continue

    print(f"🔹 Embedding Chapter {i}: {chapter_title}")

    chunks = split_into_chunks(content)

    for j, chunk in enumerate(chunks, start=1):
        embedding = create_embedding(chunk)
        if embedding:
            cursor.execute("""
                INSERT INTO maududi_documents 
                (book_id, chapter_id, heading_id, book_title, chapter_title, chunk_index, content, embedding)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
            """, (
                book_id, chapter_id, heading_id,
                book_title, chapter_title, j,
                chunk, embedding
            ))
            conn.commit()
        else:
            print(f"❌ Chunk {j} failed.")

# ✅ Cleanup
cursor.close()
conn.close()
print("✅ All embeddings completed and saved to maududi_documents.")
